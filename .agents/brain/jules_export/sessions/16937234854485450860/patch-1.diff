+
+# Colors
+$Red = "Red"
+$Green = "Green"
+$Yellow = "Yellow"
+$Cyan = "Cyan"
+
+# Find the Git root directory
+try {
+    $RootDir = git rev-parse --show-toplevel 2>$null
+} catch {
+    $RootDir = $null
+}
+
+if (-not $RootDir) {
+    Write-Host "[ERROR] Audit failed: Not a git repository." -ForegroundColor $Red
+    exit 1
+}
