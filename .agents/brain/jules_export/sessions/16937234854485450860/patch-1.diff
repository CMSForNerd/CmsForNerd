+    Partner: Generated with assistance from Google Antigravity
+    Version: v2.0
+    License: GNU GPL v3.0 or later
+#>
+
+$ErrorActionPreference = "Stop"
+$Output      = "DSOM-CLAUDE-INIT.md"
+$DocsDir     = "docs"
+$BrainDir    = ".agents\brain"
+$InventoryDir = "inventory"
+$VERSION     = "v2.0"
