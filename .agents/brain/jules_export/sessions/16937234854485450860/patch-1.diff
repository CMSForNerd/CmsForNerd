+    await page.goto('/');
+    await expect(page).toHaveTitle(/CMSForNerd/i);
+
+    const mainHeading = page.locator('h1');
+    await expect(mainHeading).toBeVisible();
+    await expect(mainHeading).toContainText('CMSForNerd');
