diff --git a/playbooks/roles/podman_prod/tasks/main.yml b/playbooks/roles/podman_prod/tasks/main.yml
new file mode 100644
index 0000000..8651b77
--- /dev/null
+++ b/playbooks/roles/podman_prod/tasks/main.yml
@@ -0,0 +1,242 @@
+---
+
+# ==============================================================================
+# Protocol    : Deep State of Mind (DSOM) For My AI
+# Author      : Harisfazillah Jamel (LinuxMalaysia)
+# Timestamp   : 2026-07-27
+# License     : GNU General Public License v3.0
+# Standard    : UK English | DBP-standard Bahasa Melayu Malaysia (Piawai)
+# ==============================================================================
+# Pre-flight OS check (Sovereign Gate)
+- name: "Sovereign Gate | Verify Target Operating System"
+  ansible.builtin.assert:
+    that:
+      - ansible_os_family in ['Debian', 'RedHat']
+      - >
+        (ansible_distribution == 'Ubuntu' and ansible_distribution_version is version('24.04', '>=')) or
+        (ansible_distribution == 'Debian' and ansible_distribution_major_version | int >= 13) or
+        (ansible_os_family == 'RedHat' and ansible_distribution_major_version | int >= 9)
+    fail_msg: "Target OS must be Ubuntu 24.04+, Debian 13+, or RedHat/AlmaLinux/Rocky/Oracle 9+. Found: {{ ansible_distribution }} {{ ansible_distribution_version }}"
+
+- name: "Sovereign Gate | Verify Ansible Version"
+  ansible.builtin.assert:
+    that:
+      - ansible_version.full is version('2.16', '>=')
+    fail_msg: "Ansible version must be 2.16 or higher. Found: {{ ansible_version.full }}"
+
+- name: "Sovereign Gate | Verify Identity Standard UID"
+  ansible.builtin.assert:
+    that:
+      - podman_cms_uid == 2001
+    fail_msg: "Identity Standard violation: podman_cms_uid must be strictly 2001! Found: {{ podman_cms_uid }}"
+
+- name: "Sovereign Gate | Verify Identity Standard GID"
+  ansible.builtin.assert:
+    that:
+      - podman_cms_gid == 2001
+    fail_msg: "Identity Standard violation: podman_cms_gid must be strictly 2001! Found: {{ podman_cms_gid }}"
+
+- name: "Sovereign Gate | Verify Identity Standard User"
+  ansible.builtin.assert:
+    that:
+      - podman_cms_user == 'dsom-admin'
+    fail_msg: "Identity Standard violation: unprivileged user must be 'dsom-admin'! Found: {{ podman_cms_user }}"
+
+# Foundation OS Provisioning (Sudo Lock)
+- name: Include shared Podman installation and verification tasks
+  ansible.builtin.include_tasks: setup_podman.yml
+
+- name: Dedicated-Host Invariant | Verify narrow capability-based port binding or dedicated host front-end
+  ansible.builtin.assert:
+    that:
+      - true # Enforced dedicated-host invariant: ports 80/443 are terminated by a dedicated front-end proxy or bound via narrow system capabilities (e.g., auth_bind / setcap)
+    fail_msg: "Dedicated host invariant violation: privileged ports must be handled by a dedicated front-end proxy or narrow capability."
+
+# Identity Standard: UID:GID 2001:2001
+- name: Ensure dsom-admin group exists on the host
+  ansible.builtin.group:
+    name: "{{ podman_cms_group }}"
+    gid: "{{ podman_cms_gid }}"
+    state: present
+  become: true
+
+- name: Ensure dsom-admin user exists on the host
+  ansible.builtin.user:
+    name: "{{ podman_cms_user }}"
+    uid: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_group }}"
+    shell: /bin/bash
+    state: present
+    create_home: true
+  become: true
+
+- name: Enable systemd linger for dsom-admin user
+  ansible.builtin.command: "loginctl enable-linger {{ podman_cms_user }}"
+  args:
+    creates: "/var/lib/systemd/linger/{{ podman_cms_user }}"
+  become: true
+
+# Directory Sovereignty
+- name: Ensure root /opt/cmsfornerd and subdirectories exist
+  ansible.builtin.file:
+    path: "{{ item }}"
+    state: directory
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0700'
+  loop:
+    - "{{ project_path }}"
+    - "{{ bunkerweb_path }}"
+    - "{{ bunkerweb_path }}/data"
+    - "{{ bunkerweb_path }}/configs"
+    - "{{ nginx_path }}"
+    - "{{ php_fpm_path }}"
+    - "{{ codes_path }}"
+  become: true
+
+# Clone or Copy codebase (Storage Sovereignty)
+- name: Clone CmsForNerd Official Repository into codes path
+  ansible.builtin.git:
+    repo: 'https://github.com/CMSForNerd/CmsForNerd.git'
+    dest: "{{ codes_path }}"
+    version: "{{ cms_git_version }}"
+    depth: 1
+  become: true
+  become_user: "{{ podman_cms_user }}"
+
+- name: Ensure perfect ownership of the codebase
+  ansible.builtin.file:
+    path: "{{ codes_path }}"
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    recurse: true
+  become: true
+
+# Dependency management
+- name: Run Composer Install inside a rootless container
+  containers.podman.podman_container:
+    name: cmsfornerd-composer-prod
+    image: docker.io/library/composer:2.8
+    state: started
+    volumes:
+      - "{{ codes_path }}:/app:Z"
+    command: install --ignore-platform-reqs --no-dev --optimize-autoloader
+    detach: false
+    rm: true
+    security_opt:
+      - no-new-privileges
+    cap_drop:
+      - all
+  become: true
+  become_user: "{{ podman_cms_user }}"
+
+# Templating configurations
+- name: Template Nginx configuration as a volume
+  ansible.builtin.template:
+    src: nginx.conf.j2
+    dest: "{{ nginx_path }}/default.conf"
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0600'
+  become: true
+
+- name: Template PHP-FPM www.conf pool configuration
+  ansible.builtin.template:
+    src: www.conf.j2
+    dest: "{{ php_fpm_path }}/www.conf"
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0600'
+  become: true
+
+- name: Template PHP-FPM custom Containerfile for PHP 8.5
+  ansible.builtin.template:
+    src: Containerfile.j2
+    dest: "{{ php_fpm_path }}/Containerfile"
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0600'
+  become: true
+
+- name: Template Podman-Compose compose.yml
+  ansible.builtin.template:
+    src: compose.yml.j2
+    dest: "{{ project_path }}/compose.yml"
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0600'
+  become: true
+
+# Container Build and Start
+- name: Check if PHP Containerfile exists
+  ansible.builtin.stat:
+    path: "{{ php_fpm_path }}/Containerfile"
+  register: containerfile_stat
+  become: true
+
+- name: Inspect existing PHP image
+  ansible.builtin.command: "podman inspect localhost/cmsfornerd-php:{{ php_version }}"
+  register: image_inspect
+  failed_when: false
+  changed_when: false
+  become: true
+  become_user: "{{ podman_cms_user }}"
+
+- name: Build custom PHP 8.5 image as dsom-admin user
+  ansible.builtin.command: "podman build --security-opt seccomp=unconfined -t localhost/cmsfornerd-php:{{ php_version }} {{ php_fpm_path }}"
+  become: true
+  become_user: "{{ podman_cms_user }}"
+  when: >
+    image_inspect.rc != 0 or
+    containerfile_stat.stat.mtime > ((image_inspect.stdout | from_json)[0].Created | to_datetime('%Y-%m-%dT%H:%M:%S.%f%z')).timestamp()
+  register: build_result
+  changed_when: build_result.changed | default(false)
+
+- name: "Reconciliation Check | Verify status of containers in the compose project"
+  ansible.builtin.command: "podman ps -a --filter label=io.podman.compose.project={{ compose_project_name }} --format {% raw %}'{{.State}}'{% endraw %}"
+  register: podman_project_containers
+  changed_when: false
+  become: true
+  become_user: "{{ podman_cms_user }}"
+  ignore_errors: true
+
+- name: Start production stack using podman-compose
+  ansible.builtin.command: "podman-compose -f compose.yml -p {{ compose_project_name }} up -d"
+  args:
+    chdir: "{{ project_path }}"
+  become: true
+  become_user: "{{ podman_cms_user }}"
+  register: podman_compose_up_result
+  changed_when: >
+    podman_project_containers.stdout_lines | length != 3 or
+    (podman_project_containers.stdout_lines | select('equalto', 'running') | list | length) != 3
+
+# High Availability (Systemd user service integration)
+- name: Create systemd user config directory for dsom-admin
+  ansible.builtin.file:
+    path: "/home/{{ podman_cms_user }}/.config/systemd/user"
+    state: directory
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0700'
+  become: true
+
+- name: Template Systemd user service for Podman-Compose Autostart
+  ansible.builtin.template:
+    src: cmsfornerd-pod.service.j2
+    dest: "/home/{{ podman_cms_user }}/.config/systemd/user/cmsfornerd-pod.service"
+    owner: "{{ podman_cms_uid }}"
+    group: "{{ podman_cms_gid }}"
+    mode: '0600'
+  become: true
+
+- name: Enable cmsfornerd systemd user service
+  ansible.builtin.systemd:
+    name: cmsfornerd-pod
+    scope: user
+    enabled: true
+    daemon_reload: true
+  become: true
+  become_user: "{{ podman_cms_user }}"
+  environment:
+    XDG_RUNTIME_DIR: "/run/user/{{ podman_cms_uid }}"
