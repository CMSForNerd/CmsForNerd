+        rm -rf "${TEMP_DIR:?}"
+    fi
+    [ -f "${METADATA_FILE}" ] && rm -f "${METADATA_FILE:?}"
+    [ -f "${HEADER_FILE}" ] && rm -f "${HEADER_FILE:?}"
+}
+trap cleanup EXIT SIGINT SIGTERM
